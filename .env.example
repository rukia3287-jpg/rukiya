# Supply credentials via your hosting platform. Never put real secrets in this file.
DISCORD_TOKEN=
OPERATOR_IDS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLIENT_SECRET_JSON=
TOKEN_JSON=
DB_PATH=rukiya_memory.db
PORT=8080

# Hybrid Brain: optional loopback text inference, no automatic model downloads.
EXTERNAL_AI_ENABLED=true
LOCAL_AI_ENABLED=false
LOCAL_AI_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=
LOCAL_AI_TIMEOUT=15
BRAIN_TIMEOUT=45
BRAIN_MAX_ACTIVE=8
BRAIN_GUILD_ACTIVE=3
BRAIN_USER_ACTIVE=2
BRAIN_PROMPT_CHARS=4000
BRAIN_CONTEXT_CHARS=24000
BRAIN_SESSION_TTL=900
BRAIN_SESSION_COUNT=256
MEMORY_AUTO_EXTRACT=false
MEMORY_HISTORY_ENABLED=false
MEMORY_RETENTION_DAYS=90

# Existing provider, search and output settings retain their existing meanings.
MAX_AI_CONCURRENCY=3
MAX_SEARCH_CONCURRENCY=2
OPENROUTER_TIMEOUT=20
GEMINI_TIMEOUT=20
SEARCH_TIMEOUT=15
AI_MAX_REPAIR_ATTEMPTS=2
GEMINI_SEARCH_ENABLED=true
GEMINI_SEARCH_DAILY_LIMIT=450
GEMINI_SEARCH_CACHE_TTL=300
MAX_MESSAGE_LENGTH=250
MAX_MEMORY_PER_USER=30
MAX_CONTEXT_MESSAGES=8
RUKIYA_AUTO_REPLY=true
RUKIYA_REASONING_ENABLED=true
RUKIYA_REASONING_EFFORT=medium
RUKIYA_MAX_COMPLETION_TOKENS=320
IDLE_CHAT_ENABLED=true
